# Copy to `.ollama-mcp.toml` in your project root.
# Only [gate] really matters -- it is the one thing that cannot be inferred safely.

[gate]
# Run in the workspace root after every delegated edit. Non-zero exit = failure,
# which rolls the edit back and escalates to Claude. Keep these FAST.
#
# A list of ARGV LISTS -- [["ruff", "check", "."]], never ["ruff check ."].
# The flat spelling is rejected at load time rather than run one character at
# a time. A command that cannot be executed at all (typo, or missing from the
# PATH this server was launched with) fails the gate: a check that did not run
# has not passed.
commands = [
  ["ruff", "check", "--quiet", "."],
]
timeout_s = 180
# Fall back to language-native checks when `commands` is empty.
autodetect = true

[models]
fast = "qwen2.5-coder:7b"
deep = "qwen3-coder:30b"
# Ollama defaults num_ctx to 4096 and truncates SILENTLY. Always set it.
fast_num_ctx = 16384
deep_num_ctx = 32768
keep_alive = "10m"
temperature = 0.1

[limits]
max_iterations = 12
request_timeout_s = 900
max_receipt_chars = 4000
max_file_bytes = 400000
max_local_retries = 1

[sandbox]
deny = [".git", ".env", "node_modules", ".venv", "__pycache__", ".pem", ".ollama-mcp"]

[i18n]
# Language of the prompt sent to the local model and of the prose in the receipt.
# "auto" decides per call from the instruction text, falling back to the machine
# locale -- a task written in Japanese gets the Japanese prompt even on an
# English-locale machine. Status tokens (APPLIED / ESCALATE / PASS / FAIL) are
# protocol and are never translated.
language = "auto"   # "auto" | "en" | "ja"
